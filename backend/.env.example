# Runtime: development | test | production
NODE_ENV=development
PORT=4000

# MongoDB connection string (local or Atlas; Atlas/local-atlas replica set required for transactions)
MONGODB_URI="mongodb+srv://USERNAME:PW@SOMETHING.r8tcyqv.mongodb.net/DEV-PROJECT?retryWrites=true&w=majority"

# Comma-separated list of allowed browser origins (Next.js app)
CORS_ORIGINS=http://localhost:3000

# pino level: debug | info | warn | error
LOG_LEVEL=info

# Exactly 32 random bytes, base64-encoded. Used for AES-256-GCM token encryption.
# Generate one with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ==========================================
# Application Configuration
# ==========================================

# Runtime: development | test | production
NODE_ENV=development
PORT=4000

# ==========================================
# MongoDB
# ==========================================

# Local MongoDB connection
# Replica set required for transactions
MONGODB_URI="mongodb+srv://USERNAME:PW@SOMETHING.r8tcyqv.mongodb.net/DEV-PROJECT?retryWrites=true&w=majority"

# ==========================================
# CORS
# ==========================================

# Allowed frontend origins (comma-separated; `*` matches a host/port run, e.g. http://localhost:30*)
CORS_ORIGINS=http://localhost:3000

# ==========================================
# Logging
# ==========================================

# debug | info | warn | error
LOG_LEVEL=info

# ==========================================
# Encryption
# ==========================================

# Generate using:
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# ==========================================
# GitHub OAuth
# ==========================================

GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET

GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback

# Token used for CI/CD (pull requests, build status, run steps, build dispatch).
# Fine-grained PAT on the target repositories with: Contents read/write,
# Pull requests read/write, Actions read/write, Workflows read/write.
GITHUB_AUTOMATION_TOKEN=

# ==========================================
# Session Security
# ==========================================

# Generate using:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=REPLACE_WITH_RANDOM_SESSION_SECRET

N8N_ANALYSIS_WEBHOOK_URL=YOUR_WEBHOOK_URL
N8N_SHARED_SECRET=REPLACE_WITH_RANDOM_SHARED_SECRET

N8N_AI_AUDIT_WEBHOOK_URL=YOUR_WEBHOOK_URL

# Optional - when empty, deployments are created without the outbound n8n call.
N8N_DEPLOYMENT_WEBHOOK_URL=

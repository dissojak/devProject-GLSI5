    {
      "parameters": {
        "jsCode": "const tree = $input.first().json;\nconst commitSha = $('branch').first().json.commit.sha;\n\nconst USEFUL =\n  /(^|\\/)(package\\.json|requirements[^/]*\\.txt|pyproject\\.toml|pom\\.xml|build\\.gradle(\\.kts)?|[^/]+\\.csproj|Dockerfile[^/]*|docker-compose[^/]*\\.ya?ml|\\.dockerignore)$|^\\.github\\/workflows\\/[^/]+\\.ya?ml$/;\nconst IGNORED = /(^|\\/)(node_modules|dist|vendor|\\.git)\\//;\nconst MAX_FILES = 40;\nconst MAX_SIZE = 200000;\n\nconst blobs = tree.tree.filter((entry) => entry.type === 'blob');\nconst treePaths = blobs.map((entry) => entry.path);\n\nconst files = blobs\n  .filter(\n    (entry) =>\n      USEFUL.test(entry.path) &&\n      !IGNORED.test(entry.path) &&\n      (entry.size ?? 0) <= MAX_SIZE,\n  )\n  .slice(0, MAX_FILES)\n  .map((entry) => ({ path: entry.path }));\n\nconst completeBody = {\n  detectedFiles: files.map((file) => file.path),\n  technologies: [],\n  components: [],\n  docker: {\n    hasDockerfile: treePaths.some((path) => /(^|\\/)dockerfile[^/]*$/i.test(path)),\n    hasCompose: treePaths.some((path) =>\n      /(^|\\/)docker-compose[^/]*\\.ya?ml$/i.test(path),\n    ),\n    findings: [],\n  },\n};\n\nreturn [\n  {\n    json: {\n      commitSha,\n      truncated: tree.truncated,\n      treePaths,\n      files,\n      completeBody,\n    },\n  },\n];"
      },
